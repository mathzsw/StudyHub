<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarefas | StudyHub</title>
</head>
<body>
    <main>
        <h1>Tarefas</h1>
        <p>Gerencie suas tarefas de estudo.</p>

        {{#if tarefas.length}}
            <ul>
                {{#each tarefas}}
                    <li>
                        <strong>{{titulo}}</strong>
                        <span> — {{Materia.nome}}</span>
                        {{#if prazo}}
                            <span> — prazo: {{prazo}}</span>
                        {{/if}}
                        <span> — {{status}}</span>
                    </li>
                {{/each}}
            </ul>
        {{else}}
            <p>Nenhuma tarefa cadastrada.</p>
        {{/if}}
    </main>
</body>
</html>
